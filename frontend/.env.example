# FILE: frontend/.env.example
#
# WHAT THIS DOES:
# Template for the frontend environment. Copy to .env and set the backend URL.
# Only VITE_ prefixed vars are exposed to the browser (Vite rule).
#
# CHANGES THIS SESSION:
# - Created with the backend base URL.
#
# WHERE IT FITS:
# Read at build time by the useAnalyse and useWatchlist hooks.

# Base URL of the FastAPI backend. Local dev default below; set the Render URL in prod.
VITE_API_BASE_URL=http://localhost:8000
