# FILE: backend/.env.example
#
# WHAT THIS DOES:
# Template of the environment variables the backend needs.
# Copy to .env and fill in real values. Never commit a real .env.
#
# CHANGES THIS SESSION:
# - Initial env template for Phase 1.
#
# WHERE IT FITS:
# Read at startup via python-dotenv (local) or the Render dashboard (prod).
#
# CALLED BY / IMPORTS FROM:
# Loaded by db/supabase_client.py and the service clients.

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Backend-only API keys (never expose to the client)
APIFY_API_TOKEN=
SERPAPI_KEY=
NEWSAPI_KEY=
GEMINI_API_KEY=
DATA_GOV_API_KEY=

# CORS: the allowed frontend origin.
# Dev default is the Vite dev server. In prod set this to the Vercel URL.
FRONTEND_ORIGIN=http://localhost:5173
